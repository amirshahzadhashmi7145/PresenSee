# PresenSee settings.
# `bash dev.sh` copies this file to .env on first run and fills every
# CHANGE_ME value with a fresh random secret. Never commit .env.
# Keep values shell-safe: one line each, no spaces, no JSON.

# --- Ports (all bound to 127.0.0.1) ---
WEB_PORT=3000
FACE_PORT=8000
PG_PORT=5432

# --- Database ---
POSTGRES_USER=presensee
POSTGRES_DB=presensee
POSTGRES_PASSWORD=CHANGE_ME_HEX
DATABASE_URL=postgresql://presensee:CHANGE_ME_HEX@127.0.0.1:5432/presensee

# --- Face service (only the web server may call it) ---
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_SERVICE_SECRET=CHANGE_ME_HEX

# --- Photo storage ---
STORAGE_DIR=../storage
# 32 random bytes, base64. Make one with: openssl rand -base64 32
PHOTO_ENC_KEY_K1=CHANGE_ME_BASE64
PHOTO_ENC_ACTIVE_KEY_ID=K1
# disk = keep the reference selfie in local storage (testing only)
# memory = keep it only in the face service's memory (use before real users)
SELFIE_STORE=disk

# --- Reverse image search ---
# mock = fake results, no key needed. tineye = real TinEye API.
IMAGE_SEARCH_PROVIDER=mock
TINEYE_API_KEY=
